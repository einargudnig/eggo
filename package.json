{
  "name": "eggo",
  "private": true,
  "workspaces": [
    "video"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && bun scripts/verify-prerender.ts",
    "preview": "vite preview",
    "deploy": "alchemy deploy --stage prod",
    "video": "bun run --cwd video studio",
    "video:render": "bun run --cwd video render",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json && tsc -p video/tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "contrast": "bun scripts/contrast.ts",
    "test": "node --test \"lint/*.test.ts\"",
    "test:e2e": "playwright test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run contrast",
    "cf-typegen": "wrangler types",
    "alchemy": "alchemy"
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "1.168.61",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.63.1",
    "@effect/platform-bun": "4.0.3",
    "@effect/platform-node": "4.0.3",
    "@playwright/test": "1.64.0",
    "@stylexjs/unplugin": "0.19.1",
    "@types/node": "22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "alchemy": "2.0.0-beta.81",
    "effect": "4.0.3",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
