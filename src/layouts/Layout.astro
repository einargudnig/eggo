---
import '../styles/global.css'
import Analytics from '@vercel/analytics/astro'


interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Eggo — Hugbúnaður og tækniráðgjöf",
  description = "Við smíðum vefsíður, hugbúnað, sjálfvirknivæðingar og gervigreindarsamþættingar. Nútímalegar lausnir fyrir nútíma fyrirtæki."
} = Astro.props;

const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY;
const posthogHost = import.meta.env.PUBLIC_POSTHOG_HOST ?? 'https://eu.i.posthog.com';
const calLink = import.meta.env.PUBLIC_CAL_LINK ?? '';
---

<!doctype html>
<html lang="is">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32 16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://eggo.is/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://eggo.is/og.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script is:inline>
      if (localStorage.getItem('theme') === 'light') {
        document.documentElement.classList.add('light');
      }
    </script>
    <script is:inline define:vars={{ calLink }}>
      window.__CAL_LINK__ = calLink || '';
    </script>
  </head>
  <body>
    <Analytics />
    <main>
      <slot />
    </main>

    {posthogKey && (
      <script>
        import posthog from 'posthog-js';

        const key = import.meta.env.PUBLIC_POSTHOG_KEY;
        const host = import.meta.env.PUBLIC_POSTHOG_HOST ?? 'https://eu.i.posthog.com';

        if (key) {
          posthog.init(key, {
            api_host: host,
            person_profiles: 'identified_only',
            capture_pageview: true,
            capture_pageleave: true,
            autocapture: false,
            persistence: 'localStorage+cookie',
          });
          (window as any).posthog = posthog;
          window.dispatchEvent(new Event('posthog:ready'));

          document.addEventListener('click', (e) => {
            const target = (e.target as HTMLElement | null)?.closest('[data-track-cta]') as HTMLElement | null;
            if (!target) return;
            posthog.capture('cta_clicked', {
              cta: target.dataset.trackCta,
              location: target.dataset.trackLocation ?? 'unknown',
              href: target.getAttribute('href') ?? null,
            });
          });
        }
      </script>
    )}

    {calLink && (
      <script is:inline>
        // Cal.com embed snippet — loads embed.js on demand
        (function (C, A, L) {
          let p = function (a, ar) { a.q.push(ar); };
          let d = C.document;
          C.Cal = C.Cal || function () {
            let cal = C.Cal, ar = arguments;
            if (!cal.loaded) {
              cal.ns = {};
              cal.q = cal.q || [];
              d.head.appendChild(d.createElement('script')).src = A;
              cal.loaded = true;
            }
            if (ar[0] === L) {
              const api = function () { p(api, arguments); };
              const namespace = ar[1];
              api.q = api.q || [];
              if (typeof namespace === 'string') {
                cal.ns[namespace] = cal.ns[namespace] || api;
                p(cal.ns[namespace], ar);
                p(cal, ['initNamespace', namespace]);
              } else {
                p(cal, ar);
              }
              return;
            }
            p(cal, ar);
          };
        })(window, 'https://app.cal.com/embed/embed.js', 'init');
        Cal('init', 'discovery', { origin: 'https://cal.com' });
        Cal.ns.discovery('ui', {
          theme: document.documentElement.classList.contains('light') ? 'light' : 'dark',
          cssVarsPerTheme: {
            light: { '--cal-brand': '#b8863a' },
            dark: { '--cal-brand': '#d4a054' },
          },
          hideEventTypeDetails: false,
          layout: 'month_view',
        });
        Cal.ns.discovery('on', {
          action: 'bookingSuccessful',
          callback: function (e) {
            if (window.posthog) {
              window.posthog.capture('discovery_call_booked', {
                event_type: e && e.detail && e.detail.data ? e.detail.data.eventType : undefined,
              });
            }
          },
        });
        Cal.ns.discovery('on', {
          action: 'linkReady',
          callback: function () {
            if (window.posthog) window.posthog.capture('booking_widget_opened');
          },
        });
      </script>
    )}
  </body>
</html>
